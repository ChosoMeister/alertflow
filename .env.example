# Environment Configuration for AlertFlow

# ===================
# Redis Configuration
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_a_strong_redis_password
REDIS_URL=redis://redis:6379/0

# ===================
# SMTP Ingestor
# ===================
SMTP_LISTEN_HOST=0.0.0.0
SMTP_LISTEN_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_STARTTLS=false


# ===================
# Ollama AI (Default AI provider)
# ===================
OLLAMA_BASE_URL=https://your-ollama-instance.example.com/v1/chat/completions
OLLAMA_MODEL=gpt-oss:120b
# Maximum number of configured AI providers attempted per alert.
AI_MAX_PROVIDER_ATTEMPTS=3
# Input budget keeps fallback models with 4096-token contexts usable.
AI_BODY_MAX_CHARS=2500

# ===================
# Bootstrap fallback for unmatched senders and internal notifications.
# Normal Rules are Destination-only and do not store these values.
# Configure connectors/destinations in Web UI -> Notification Channels.
# ===================
TELEGRAM_ENABLED=true
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_DEFAULT_THREAD_ID=0
MATRIX_ENABLED=true
MATRIX_DEFAULT_ROOM_ID=

# NOTE: Bot tokens and access tokens are now stored in Redis
# Configure via: Web UI -> Channels -> Add Channel

# ===================
# Notification Behavior
# ===================
# DEFAULT_NOTIFICATION_CHANNEL=both  # Now managed via UI
FAILOVER_ENABLED=true
MESSAGE_VERBOSITY=standard
DEFAULT_NOTIFICATION_CHANNEL=both

# ===================
# Telegram Proxy (Optional)
# ===================
# Route Telegram API calls through a Cloudflare Worker proxy.
# Useful when api.telegram.org is blocked or unreliable.
# Set USE_TELEGRAM_PROXY=true and provide your proxy base URL.
# Can also be configured per-channel via Web UI → Channels → proxy_base_url field.
USE_TELEGRAM_PROXY=false
TELEGRAM_PROXY_BASE_URL=
# Example: TELEGRAM_PROXY_BASE_URL=https://tg.mydomain.ir
# Open a short circuit after repeated network failures; content errors still use plain-text fallback.
TELEGRAM_CIRCUIT_THRESHOLD=5
TELEGRAM_CIRCUIT_WINDOW_SECONDS=60
TELEGRAM_CIRCUIT_OPEN_SECONDS=120
# Exercise the configured fallback without creating alerts or notifications (default: every 6h).
FALLBACK_CANARY_INTERVAL_SECONDS=21600

# ===================
# API Server
# ===================
API_HOST=0.0.0.0
API_PORT=8000
# ⚠️ CHANGE ME: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Local HTTP only. Set true behind HTTPS in production.
COOKIE_SECURE=false
LOKI_URL=http://loki:3100
ALLOY_URL=http://alloy:12345
DISK_WARNING_PERCENT=70
DISK_CRITICAL_PERCENT=85
LOKI_GROWTH_WARNING_MB_PER_HOUR=250
# Host directory to inspect for disk-capacity alerts. Use / only when this access is intentional.
HOST_DISK_MONITOR_PATH=.
ALERT_STORM_WINDOW_SECONDS=300
ALERT_STORM_THRESHOLD=5
ALERT_STORM_COOLDOWN_SECONDS=300
GLOBAL_STORM_MAX_NOTIFICATIONS=20
GLOBAL_STORM_WINDOW_SECONDS=300
STORM_SUMMARY_INTERVAL_SECONDS=300
INCIDENT_SLA_MINUTES=60
INCIDENT_RETENTION_DAYS=7
DLQ_RETENTION_DAYS=7
DLQ_MAX_ITEMS=1000
WEBHOOK_AUTH_TOKEN=change_this_to_a_random_webhook_token
CORS_ORIGINS=http://localhost:3000

# ===================
# Web UI
# ===================
# NOTE: This is a BUILD-TIME variable. Change it BEFORE building the web-ui container.
# After changing, rebuild with: docker-compose up -d --build web-ui
#
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (direct, no reverse proxy):
# NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (with Nginx/Traefik reverse proxy + SSL):
# NEXT_PUBLIC_API_URL=https://alerts.example.com
