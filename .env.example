# Environment Configuration for Sentinel-AI-Core

# ===================
# Redis Configuration
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ===================
# SMTP Ingestor
# ===================
SMTP_LISTEN_HOST=0.0.0.0
SMTP_LISTEN_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_STARTTLS=false# ⚠️ CHANGE ME: Set a strong password for SMTP authentication


# ===================
# Ollama AI (Default AI provider)
# ===================
OLLAMA_BASE_URL=https://your-ollama-instance.example.com/v1/chat/completions
OLLAMA_MODEL=gpt-oss:120b

# ===================
# Telegram & Matrix Configuration
# Now managed via Web UI (Channels page)
# Legacy fallback:
# ===================
TELEGRAM_ENABLED=true
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_DEFAULT_THREAD_ID=0
MATRIX_ENABLED=true
MATRIX_DEFAULT_ROOM_ID=

# NOTE: Bot tokens and access tokens are now stored in Redis
# Configure via: Web UI -> Channels -> Add Channel

# ===================
# Notification Behavior
# ===================
# DEFAULT_NOTIFICATION_CHANNEL=both  # Now managed via UI
FAILOVER_ENABLED=true
MESSAGE_VERBOSITY=standard

# ===================
# Telegram Proxy (Optional)
# ===================
# Route Telegram API calls through a Cloudflare Worker proxy.
# Useful when api.telegram.org is blocked or unreliable.
# Set USE_TELEGRAM_PROXY=true and provide your proxy base URL.
# Can also be configured per-channel via Web UI → Channels → proxy_base_url field.
USE_TELEGRAM_PROXY=false
TELEGRAM_PROXY_BASE_URL=
# Example: TELEGRAM_PROXY_BASE_URL=https://tg.mydomain.ir

# ===================
# API Server
# ===================
API_HOST=0.0.0.0
API_PORT=8000
# ⚠️ CHANGE ME: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===================
# Web UI
# ===================
# NOTE: This is a BUILD-TIME variable. Change it BEFORE building the web-ui container.
# After changing, rebuild with: docker-compose up -d --build web-ui
#
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (direct, no reverse proxy):
# NEXT_PUBLIC_API_URL=http://alert.orchidpharmed.com:8000
# Production (with Nginx/Traefik reverse proxy + SSL):
# NEXT_PUBLIC_API_URL=https://alert.orchidpharmed.com
